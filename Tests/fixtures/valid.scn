SDFObject
// Ground, a sphere with a bite taken out, and a spinning torus.
	COMBAdd
	SDFPlane color 0.4 0.4 0.4 normal 0 1 0 offset 0
		stepBack
	COMBAdd
	SDFObject
		OPTranslate translation 0 1 3
		COMBAdd
		SDFSphere color 1 0 0 radius 1
			ANSmoothCycle3D propName color period 2 2 2 amplitude 0.5 0 0 phase 0 0 0
			stepBack
		OPTranslate translation 0 0 -1
		COMBSubtractSmooth smoothing 0.1 colorBlending 1 colorShifting 0
		ANSmoothCycle1D propName smoothing period 1 amplitude 0.05 phase 0
		SDFBox color 1 1 1 dimensions 0.5 0.5 0.5
			stepBack
		stepBack
	COMBAdd
	SDFObject
		OPTranslate translation -2.5 1 3
		OPRotate axis 1 0 0 rotations 0.25
		ANContinuous1D propName rotations amplitude 0.1 phase 0
		COMBAdd onTime 1 offTime 0 phase 0 overwriteColor 0
		SDFTorus color 0 0.7 1 radii 1 0.25 axis 1
			stepBack
		stepBack
LightSource position 2 6 -2 luminance 150 ambientPower 0.2 color 1 1 1
end
