SDFObject m_color 1 1 1
	COMBAdd m_smoothing 0.5 m_colorBlending 1 m_colorShifting 0
	SDFObject m_color 1 1 1
		OPTranslate m_translation -0.25 0 -0.25
		COMBAdd m_smoothing 0.5 m_colorBlending 1 m_colorShifting 0
		SDFTorus m_color 0 0 1 m_radii 1 0.4
			OPTranslate m_translation 0.5 0 0
			COMBExclude m_smoothing 0.5 m_colorBlending 1 m_colorShifting 0
			SDFTorus m_color 0 1 0 m_radii 1 0.4
				stepBack
			stepBack
		COMBExclude m_smoothing 0.5 m_colorBlending 1 m_colorShifting 0
		SDFObject m_color 1 1 1
			OPTranslate m_translation 0 0 -0.5
			COMBAdd m_smoothing 0.5 m_colorBlending 1 m_colorShifting 0
			SDFTorus m_color 1 0 0 m_radii 1 0.4
				OPTranslate m_translation 0.5 0 0
				COMBExclude m_smoothing 0.5 m_colorBlending 1 m_colorShifting 0
				SDFTorus m_color 1 0.87 0 m_radii 1 0.4
					stepBack
				stepBack
			stepBack
		stepBack
	OPTranslate m_translation 0 0.5 0
	COMBSubtract m_smoothing 0.5 m_colorBlending 1 m_colorShifting 0
	SDFBox m_color 1 1 1 m_dimensions 10 1 10
		stepBack
	stepBack
LightSource m_position 0.5 2 0 m_luminance 5 m_color 1 1 1 m_ambientPower 0.5
end
