#version 450

// 1. Tell the GPU how many threads to run per block (8x8 is standard)
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// 2. Mirror your C++ structure exactly
struct PixelOutput {
    float r, g, b;
    float depth;
};

// 3. Match the Binding Slot 0 blueprint we set up in our Descriptor Set!
layout(std430, binding = 0) buffer OutputBuffer {
    PixelOutput pixels[];
};

// Console dimension constants
const uint CONSOLE_WIDTH = 120;
const uint CONSOLE_HEIGHT = 40;

void main() {
    // Determine the current console coordinate (X, Y) this thread is handling
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    // Guard constraint: Drop out if a thread spawns outside the console boundary
    if (x >= CONSOLE_WIDTH || y >= CONSOLE_HEIGHT) {
        return;
    }

    // Map the 2D grid coordinate to a 1D flat array index
    uint index = y * CONSOLE_WIDTH + x;

    // --- YOUR RAYMARCHING LOGIC GOES HERE ---
    // For now, let's inject a placeholder test pattern
    // Scale UV coordinates from 0.0 to 1.0 across the screen
    float u = float(x) / float(CONSOLE_WIDTH);
    float v = float(y) / float(CONSOLE_HEIGHT);

    pixels[index].r = u;            // Red gradient left-to-right
    pixels[index].g = v;            // Green gradient top-to-bottom
    pixels[index].b = 0.0f;
    pixels[index].depth = 50.0f * (1.0f - u); // Fake depth calculation
}